# Copy this file to .env and replace placeholders as needed.
# Never commit the copied .env file.

# Required for AI code generation, routing, and literature summarization.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MODEL_SUMMARY=gpt-4.1-mini

# Redis/Celery. CELERY_* values override the corresponding REDIS_URL-derived URLs.
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Shared task output directory.
BIO_LAB_JOB_DIR=output/jobs

# Shared human-readable upload limit used by FastAPI and Streamlit.
MAX_UPLOAD_SIZE_GB=5

# Literature service and search limits.
EUROPE_PMC_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
LITERATURE_YEARS=5
LITERATURE_MAX_RESULTS=10

# Streamlit settings.
BACKEND_URL=http://localhost:8000
POLL_TIMEOUT_MINUTES=30
